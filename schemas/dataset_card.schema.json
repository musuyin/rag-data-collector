{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multimodal Dataset Card",
  "type": "object",
  "required": ["record_id", "record_type", "dataset_name", "modalities", "formats", "license_status", "source_id", "download_url", "sample_validation_status", "record_status"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"const": "dataset"},
    "dataset_name": {"type": "string", "minLength": 1},
    "modalities": {"type": "array", "minItems": 1, "items": {"enum": ["image", "video", "infrared", "audio", "rf", "radar", "trajectory", "flight_log", "other"]}},
    "sample_count": {"type": "integer", "minimum": 0},
    "formats": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "label_schema": {"type": "string"},
    "collection_environment": {"type": "string"},
    "license_status": {"enum": ["open", "research_only", "restricted", "unknown"]},
    "source_id": {"type": "string", "minLength": 1},
    "download_url": {"type": "string", "minLength": 1},
    "sample_validation_status": {"enum": ["pending", "passed", "failed", "partial"]},
    "record_status": {"enum": ["draft", "reviewed", "approved"]}
  }
}
