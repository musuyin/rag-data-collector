{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conflict Register Record",
  "type": "object",
  "required": ["record_id", "record_type", "entity_id", "field", "conflicting_values", "source_ids", "status"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"const": "conflict"},
    "entity_id": {"type": "string", "minLength": 1},
    "field": {"type": "string", "minLength": 1},
    "conflicting_values": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "source_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "status": {"enum": ["open", "under_review", "resolved", "accepted_difference"]},
    "resolution": {"type": "string"}
  }
}
