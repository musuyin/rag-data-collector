# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
# uv's resolution lock is intentionally committed; only its local cache is ignored.
.uv-cache/

# Operating system / editors
.DS_Store
.vscode/
.idea/

# Sensitive or non-reproducible local state
.env
.env.*
*.pem
*.key
*.cookie
secrets/

# Never commit full raw or transient payloads; keep directory sentinels only.
data/raw/**
!data/raw/.gitkeep
data/staging/**
!data/staging/.gitkeep
data/curated/**
!data/curated/.gitkeep
!data/curated/controlled_samples/
!data/curated/controlled_samples/index.json
data/samples/**
!data/samples/.gitkeep
!data/samples/reproduction_results/
!data/samples/reproduction_results/*.json

# Large local dataset packages and extraction products
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
*.h5
*.hdf5
*.bag
*.pcap
*.pcapng
*.mp4
*.avi
*.mov
*.mkv
